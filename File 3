#include <Geode/Geode.hpp>
#include <Geode/modify/LevelInfoLayer.hpp>
#include <Geode/modify/LevelCell.hpp>

using namespace geode::prelude;

static void fakeRate(GJGameLevel* level) {
    if (!level || level->m_levelType != GJLevelType::Editor) return;

    auto name = Mod::get()->getSettingValue<std::string>("difficulty");
    int demon = 6;
    if (name == "Easy Demon")        demon = 3;
    else if (name == "Medium Demon") demon = 4;
    else if (name == "Hard Demon")   demon = 0;
    else if (name == "Insane Demon") demon = 5;

    level->m_demon = 1;
    level->m_demonDifficulty = demon;
    level->m_stars = 10;
    level->m_ratings = 10;
    level->m_ratingsSum = 100;

    if (Mod::get()->getSettingValue<bool>("fake-complete")) {
        level->m_normalPercent = 100;
    }
}

class $modify(FakeLevelInfoLayer, LevelInfoLayer) {
    bool init(GJGameLevel* level, bool challenge) {
        fakeRate(level);
        return LevelInfoLayer::init(level, challenge);
    }
};

class $modify(FakeLevelCell, LevelCell) {
    void loadFromLevel(GJGameLevel* level) {
        fakeRate(level);
        LevelCell::loadFromLevel(level);
    }
};
